{
  "display_information": {
    "name": "matterbridge",
    "description": "Bridge bidirectionnel Slack et Discord"
  },
  "features": {
    "bot_user": {
      "display_name": "matterbridge",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "channels:read",
        "chat:write",
        "users:read",
        "groups:read",
        "groups:history",
        "chat:write.customize",
        "files:read",
        "files:write",
        "reactions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups",
        "member_joined_channel"
      ]
    },
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
